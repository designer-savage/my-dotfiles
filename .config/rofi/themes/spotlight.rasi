/* ───────────────────────────────────────────────────────────────────────────
   Spotlight — application launcher (SUPER+R)

   Structure mirrors macOS Spotlight: a single translucent capsule anchored in
   the upper third of the screen, showing only the query field until the user
   types (`listview { require-input: true }`), then growing downwards into the
   result list.

   The frosted-glass effect is NOT drawn here — rofi paints a translucent
   surface and Hyprland blurs whatever is behind it:
       hypr/layerrules.lua → layer_rule({ namespace = "rofi" }, blur)
   ─────────────────────────────────────────────────────────────────────────── */

@import "~/.config/rofi/glass.rasi"

configuration {
    show-icons:          true;
    icon-theme:          "Tela-circle-dark";
    display-drun:        "";
    drun-display-format: "{name}";
    matching:            "fuzzy";
    sorting-method:      "fzf";
    sort:                true;
    kb-cancel:           "Escape,Super+r";
}

* {
    font: "Adwaita Sans 19";
}

/* ── The glass capsule ─────────────────────────────────────────────────── */
window {
    location:         north;
    anchor:           north;
    y-offset:         320px;
    width:            1000px;
    padding:          0;

    background-color: @glass;
    /* Top-edge sheen: a light source above the panel, the way macOS glass
       catches the desktop behind it. */
    background-image: linear-gradient(to bottom, #FFFFFF14, #FFFFFF00);
    border:           1px;
    border-color:     @hairline;
    border-radius:    26px;
    cursor:           "default";
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  0;
    padding:  0;
}

/* ── Query field ───────────────────────────────────────────────────────── */
inputbar {
    children:      [ textbox-glyph, entry ];
    padding:       26px 30px 26px 28px;
    spacing:       18px;
    border-radius: 26px 26px 0 0;
}

textbox-glyph {
    expand:         false;
    content:        "󰍉";
    font:           "JetBrainsMono Nerd Font 34";
    text-color:     @text-secondary;
    vertical-align: 0.5;
}

entry {
    font:              "Adwaita Sans Light 28";
    text-color:        @text;
    placeholder:       "Spotlight Search";
    placeholder-color: @text-tertiary;
    vertical-align:    0.5;
    cursor:            text;
    blink:             true;
}

/* ── Results ───────────────────────────────────────────────────────────── */
/* The divider lives on the listview, not the inputbar, so that it disappears
   together with the list while the query is still empty. */
listview {
    require-input: true;
    lines:         8;
    columns:       1;
    dynamic:       true;
    fixed-height:  false;
    cycle:         true;
    scrollbar:     false;
    spacing:       2px;
    padding:       10px;
    border:        1px 0 0 0;
    border-color:  @divider;
}

element {
    orientation:      horizontal;
    children:         [ element-icon, element-text ];
    padding:          12px 18px;
    spacing:          18px;
    border:           0;
    border-radius:    13px;
    background-color: transparent;
    text-color:       @text-secondary;
    cursor:           pointer;
}

element-icon {
    size:           38px;
    vertical-align: 0.5;
    cursor:         inherit;
}

element-text {
    vertical-align: 0.5;
    cursor:         inherit;
}

element normal.normal,
element normal.active,
element alternate.normal,
element alternate.active {
    background-color: transparent;
    text-color:       @text-secondary;
}

element selected.normal,
element selected.active {
    background-color: @accent-fill;
    text-color:       @text;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color:       @accent;
}

element selected.urgent {
    background-color: @accent-fill;
    text-color:       @text;
}

/* ── Empty state ───────────────────────────────────────────────────────── */
message {
    padding:      22px 30px 28px 30px;
    border:       1px 0 0 0;
    border-color: @divider;
}

textbox {
    text-color:       @text-tertiary;
    background-color: transparent;
    font:             "Adwaita Sans 18";
}
