/* ───────────────────────────────────────────────────────────────────────────
   Wallpapers — thumbnail grid (SUPER+W)

   Same glass material and search-field grammar as the Spotlight launcher, so
   the two panels read as one system. The difference is the payload: a 4-column
   gallery of 16:10 tiles, which is the screen's own aspect ratio.

   Driven by rofi/scripts/wallpaper-picker.sh.
   ─────────────────────────────────────────────────────────────────────────── */

@import "~/.config/rofi/glass.rasi"

configuration {
    show-icons: true;
    kb-cancel:  "Escape,Super+w";
}

* {
    font: "Adwaita Sans 16";
}

window {
    location:         center;
    anchor:           center;
    width:            1520px;
    padding:          0;

    background-color: @glass;
    background-image: linear-gradient(to bottom, #FFFFFF14, #FFFFFF00);
    border:           1px;
    border-color:     @hairline;
    border-radius:    26px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  0;
    padding:  0;
}

/* ── Search field, identical grammar to the launcher ───────────────────── */
inputbar {
    children:      [ textbox-glyph, entry ];
    padding:       24px 30px 24px 28px;
    spacing:       18px;
    border-radius: 26px 26px 0 0;
}

textbox-glyph {
    expand:         false;
    content:        "󰍉";
    font:           "JetBrainsMono Nerd Font 30";
    text-color:     @text-secondary;
    vertical-align: 0.5;
}

entry {
    font:              "Adwaita Sans Light 25";
    text-color:        @text;
    placeholder:       "Search wallpapers";
    placeholder-color: @text-tertiary;
    vertical-align:    0.5;
    cursor:            text;
    blink:             true;
}

/* ── Gallery ───────────────────────────────────────────────────────────── */
listview {
    columns:       4;
    lines:         3;
    fixed-columns: true;
    fixed-height:  true;
    dynamic:       false;
    cycle:         true;
    scrollbar:     false;
    spacing:       10px;
    padding:       14px;
    border:        1px 0 0 0;
    border-color:  @divider;
}

element {
    orientation:      vertical;
    children:         [ element-icon, element-text ];
    padding:          10px 10px 12px 10px;
    spacing:          10px;
    border:           1px;
    border-color:     transparent;
    border-radius:    18px;
    background-color: transparent;
    cursor:           pointer;
}

/* squared:false lets the tile keep the image's own 16:10 ratio instead of
   being padded out into a square with dead space above and below. */
element-icon {
    squared:       false;
    size:          335px;
    padding:       -63px 0px;
    border-radius: 11px;
    cursor:        inherit;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    font:             "Adwaita Sans 15";
    cursor:           inherit;
}

element normal.normal,
element normal.active,
element alternate.normal,
element alternate.active {
    background-color: transparent;
    text-color:       @text-secondary;
    border-color:     transparent;
}

element selected.normal,
element selected.active {
    background-color: @accent-fill;
    border-color:     @accent;
    text-color:       @text;
}


element normal.urgent,
element alternate.urgent,
element selected.urgent {
    background-color: transparent;
    text-color:       @text-secondary;
    border-color:     transparent;
}

message {
    padding:      26px 30px;
    border:       1px 0 0 0;
    border-color: @divider;
}

textbox {
    text-color:       @text-tertiary;
    background-color: transparent;
    font:             "Adwaita Sans 16";
}
