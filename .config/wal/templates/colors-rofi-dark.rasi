* {{
    /* ─── Core tokens ─── */
    bg:           {background};
    fg:           {foreground};
    accent:       {color5};
    muted:        {color8};
    danger:       {color1};
    selected-bg:  {color5};
    selected-fg:  {background};

    /* ─── Surfaces ─── */
    surface-1:    rgba(255, 255, 255, 0.04);
    surface-2:    rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.07);
}}
